  "scenario": {
    "name": "bifrost-failover",
    "description": "Test 2 (routing and failover) on Bifrost transports/v2.2.6. Needs the test window in README.md: key aliases test-gemini-broken, test-gemini-broken-norule and test-claude-broken (model ids that don't exist on the Agent Platform: real upstream errors), the harness key allowed to use them, and two routing rules (governance.routing_rules) that fail test-gemini-broken over to Claude and test-claude-broken over to Gemini. Retries are off (Bifrost's default). Bifrost's mocker plugin is not compiled into the gateway, so no case forces an error on a healthy model; caller-side failover uses the request's own fallbacks list.",
    "record_headers": [],
    "cases": [
      {
        "name": "gemini-healthy",
        "model": "gemini-3.8-flash",
        "kind": "gemini",
        "repeat": 2,
        "expect": {
          "status": 200,
          "model": "gemini-3.8-flash"
        }
      },
      {
        "name": "gemini-broken-rule-falls-back",
        "model": "test-gemini-broken",
        "kind": "gemini",
        "repeat": 3,
        "expect": {
          "status": 200,
          "model": "claude-haiku-5-5"
        }
      },
      {
        "name": "gemini-broken-rule-falls-back-stream",
        "model": "test-gemini-broken",
        "kind": "gemini",
        "stream": true,
        "repeat": 3,
        "expect": {
          "status": 200,
          "model": "claude-haiku-5-5"
        }
      },
      {
        "name": "claude-broken-rule-falls-back",
        "model": "test-claude-broken",
