{"case": "ben-what-iban-claude", "attempt": 0, "started_at": 1793550697.6282985, "status": 200, "latency_s": 0.8794, "ttft_s": null, "answered_model": "claude-haiku-5-5", "answer": "An IBAN (International Bank Account Number) is used to identify a bank account uniquely across countries, so that international and domestic payments such as transfers and direct debits are routed correctly and processed quickly with fewer errors. It includes the country code, check digits, and the bank and account identifiers.", "headers": {"x-kong-llm-model": "gemini/claude-haiku-5-5", "x-kong-request-id": "ea363969169c840a269695406a1c5218"}, "error": null, "expected": true, "mismatch": [], "classification": "passed"}
